---
import { dateLabel, entryTags, tagsPath } from "../lib/content"
import type { Entry } from "../lib/content"

interface Props {
  entry: Entry
  href?: string
}

const { entry, href } = Astro.props
const { date } = entry.data
---

<div class="entry-meta">
  {href ? (
    <a href={href} class="entry-date">
      <time datetime={date}>{dateLabel(date, true)}</time>
    </a>
  ) : (
    <time class="entry-date" datetime={date} data-entry-part="time">
      {dateLabel(date, true)}
    </time>
  )}
  {entryTags(entry).map((tag) => (
    <a class="tag-link" href={tagsPath(entry.collection, tag)}>
      #{tag}
    </a>
  ))}
</div>
