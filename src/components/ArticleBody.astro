---
import type { MarkdownHeading } from "astro"
import { ImageOff } from "lucide-react"
import type { Entry } from "../lib/content"
import { entryPath, entryTitle } from "../lib/content"
import { articleMarkup, articleScope } from "../lib/markup"
import ArticleToc from "./ArticleToc.astro"
import ReadingActions from "./ReadingActions.astro"
import sidenotesScript from "../lib/reading-sidenotes.client.ts?inline-reading"
import codeFoldsScript from "../lib/reading-code.client.ts?inline-reading"
import imagesScript from "../lib/reading-images.client.ts?inline-reading"

interface Props {
  entry: Entry
  headings: MarkdownHeading[]
  embedded?: boolean
}

const { entry, headings, embedded = false } = Astro.props
const scope = articleScope(entry)
const toc = entry.data.toc && !embedded ? headings.filter(({ depth, slug }) => depth >= 2 && depth <= 4 && slug !== "footnote-label" && !slug.startsWith("sidenote-")) : []
const canonical = new URL(entryPath(entry), Astro.site)
const article = articleMarkup((await Astro.slots.render("default")) ?? "", canonical, embedded ? scope : undefined, import.meta.env.BASE_URL)
---

{toc.length > 0 && <ArticleToc scope={scope} title={entryTitle(entry)} headings={toc} />}
{article.hasReadingActions && <ReadingActions />}
<div
  id={scope}
  class="reading"
  data-reading-actions={article.hasReadingActions ? "" : undefined}
  data-has-sidenotes={article.hasSidenotes ? "" : undefined}
  data-has-images={article.hasImages ? "" : undefined}
  data-has-code-folds={article.hasCodeFolds ? "" : undefined}
>
  <Fragment set:html={article.html} />
  {article.hasImages && (
    <template data-image-retry>
      <button class="loading-failed" type="button" hidden>
        <ImageOff aria-hidden="true" focusable="false" />
        <span>点击重试</span>
      </button>
    </template>
  )}
</div>
{article.hasSidenotes && <script is:inline set:html={sidenotesScript}></script>}
{article.hasCodeFolds && <script is:inline set:html={codeFoldsScript}></script>}
{article.hasImages && <script is:inline set:html={imagesScript}></script>}
