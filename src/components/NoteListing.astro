---
import SiteLayout from "../layouts/SiteLayout.astro"
import Timeline from "./Timeline.astro"
import type { CollectionEntry } from "astro:content"
import { renderEntry } from "../lib/entry-render"
import { basePath } from "../lib/content-format"
import { ChevronLeft, ChevronRight } from "lucide-react"

interface Props {
  entries: CollectionEntry<"notes">[]
  title: string
  root?: string
  current?: number
  total?: number
}

const { entries, title, root = basePath("notes/"), current = 1, total = 1 } = Astro.props
const numbered = (page: number) => (page === 1 ? root : root + "page/" + page + "/")
const notes = await Promise.all(entries.map(async (entry) => ({ entry, rendered: await renderEntry(entry) })))
---

<SiteLayout title={title} hasKatex={notes.some(({ rendered }) => rendered.hasKatex)}>
  <section class="shell">
    <h1 class="section-title">{title}</h1>
    <Timeline entries={notes} />
    {total > 1 && (
      <nav class="notes-pagination" aria-label="分页">
        {current > 1 ? (
          <a class="notes-page-link" href={numbered(current - 1)} rel="prev" aria-label="上一页">
            <ChevronLeft aria-hidden="true" />
          </a>
        ) : (
          <span class="notes-page-link" aria-hidden="true">
            <ChevronLeft />
          </span>
        )}
        <span class="notes-page-count">
          {current} / {total}
        </span>
        {current < total ? (
          <a class="notes-page-link" href={numbered(current + 1)} rel="next" aria-label="下一页">
            <ChevronRight aria-hidden="true" />
          </a>
        ) : (
          <span class="notes-page-link" aria-hidden="true">
            <ChevronRight />
          </span>
        )}
      </nav>
    )}
  </section>
</SiteLayout>
