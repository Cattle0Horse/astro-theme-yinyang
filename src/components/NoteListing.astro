---
import SiteLayout from "../layouts/SiteLayout.astro"
import Timeline from "./Timeline.astro"
import type { Entry } from "../lib/content"
import { basePath } from "../lib/content-format"

interface Props {
  entries: Entry[]
  title: string
  root?: string
  current?: number
  total?: number
}

const { entries, title, root = basePath("notes/"), current = 1, total = 1 } = Astro.props
const numbered = (page: number) => (page === 1 ? root : root + "page/" + page + "/")
---

<SiteLayout title={title}>
  <section class="shell">
    <h1 class="section-title">{title}</h1>
    <Timeline entries={entries} notes />
    {total > 1 && (
      <nav class="article-toolbar" aria-label="分页">
        {current > 1 && (
          <a class="article-action" href={numbered(current - 1)}>
            上一页
          </a>
        )}
        <span>
          {current} / {total}
        </span>
        {current < total && (
          <a class="article-action" href={numbered(current + 1)}>
            下一页
          </a>
        )}
      </nav>
    )}
  </section>
</SiteLayout>
