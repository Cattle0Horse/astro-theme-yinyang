---
import { dateParts } from "../lib/content-format"
import { dateLabel, entryPath, entryTags, entryTitle, tagsPath } from "../lib/content"
import type { Entry } from "../lib/content"
import EntryContent from "./EntryContent.astro"
import NoteSources from "./NoteSources.astro"

interface Props {
  entries: Entry[]
  notes?: boolean
}

const { entries, notes = false } = Astro.props
const groups = Map.groupBy(entries, ({ data }) => {
  const { year, month } = dateParts(data.date)
  return notes ? year + " / " + month : year
})
---

<div class="timeline">
  {!entries.length && <p class="text-muted">暂无内容</p>}
  {[...groups].map(([label, group]) => (
    <section class="timeline-group">
      <h2 class="timeline-heading">{label}</h2>
      {group.map((entry) => {
        const href = entryPath(entry)
        const time = dateParts(entry.data.date).time
        const tags = entryTags(entry)
        return entry.collection === "notes" ? (
          <article class="timeline-item note-entry" data-entry-preview={href}>
            <a class="note-entry-time" href={href}>
              <time datetime={entry.data.date} data-entry-part="time">
                {dateLabel(entry.data.date)}
                {time && " · " + time}
              </time>
            </a>
            {entry.data.title && (
              <h3 class="note-entry-title">
                <a class="entry-name" href={href}>
                  <span data-entry-part="title">{entry.data.title}</span>
                </a>
              </h3>
            )}
            <NoteSources source={entry.data.source} />
            <EntryContent entry={entry} embedded />
            {tags.length > 0 && (
              <div class="note-tags" aria-label="标签">
                {tags.map((tag) => (
                  <a class="tag-link" href={tagsPath("notes", tag)}>
                    #{tag}
                  </a>
                ))}
              </div>
            )}
          </article>
        ) : (
          <div class="timeline-item entry-line" data-entry-preview={href}>
            <time class="entry-date" datetime={entry.data.date} data-entry-part="time">
              {dateLabel(entry.data.date)}
            </time>
            <a href={href} class="entry-name">
              <span data-entry-part="title">{entryTitle(entry)}</span>
            </a>
          </div>
        )
      })}
    </section>
  ))}
</div>
