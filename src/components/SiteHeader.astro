---
import Appearance from "./Appearance"
import { site } from "../site.config"
import { basePath } from "../lib/content-format"
import { ChevronDown, House, NotebookPen, Rss, Tags } from "lucide-react"
import type { Appearance as Preference } from "../lib/appearance"

interface Props {
  initial: Preference
}

const { initial } = Astro.props
const pathname = Astro.url.pathname.replace(/\/$/u, "")
const links = [
  { href: basePath(""), section: basePath("posts/"), label: "Blog", icon: House },
  { href: basePath("notes/"), section: basePath("notes/"), label: "Notes", icon: NotebookPen },
  { href: basePath("tags/"), section: basePath("tags/"), label: "标签", icon: Tags },
  { href: basePath("index.xml"), label: "RSS", icon: Rss }
].map((link) => ({
  ...link,
  current: pathname === link.href.replace(/\/$/u, "") ? ("page" as const) : link.section && Astro.url.pathname.startsWith(link.section) ? ("location" as const) : undefined
}))
const currentLabel = links.find(({ current }) => current)?.label ?? "导航"
---

<header class="site-header shell">
  <a class="site-name" href={basePath("")}>
    {site.title}
  </a>
  <p class="site-description">{site.description}</p>
  <div class="header-row flex items-center justify-between">
    <Appearance initial={initial} palettes={site.palettes} client:load />
    <nav aria-label="主导航" class="header-desktop flex shrink-0 flex-wrap justify-end" transition:persist="desktop-navigation">
      {links.map(({ href, label, icon: Icon, current }) => (
        <a href={href} class="header-link" aria-current={current}>
          <Icon aria-hidden="true" />
          {label}
        </a>
      ))}
    </nav>
    <details class="header-menu">
      <summary class="header-menu-toggle" aria-label="主导航">
        <span>{currentLabel}</span>
        <ChevronDown aria-hidden="true" />
      </summary>
      <nav aria-label="主导航">
        {links.map(({ href, label, icon: Icon, current }) => (
          <a href={href} class="header-link" aria-current={current}>
            <Icon aria-hidden="true" />
            {label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>

<script>
  import type { TransitionBeforeSwapEvent } from "astro:transitions/client"
  import { closeHeaderMenu, openHeaderMenu } from "./header-menu"

  document.addEventListener("astro:before-swap", (event) => {
    const { newDocument } = event as TransitionBeforeSwapEvent
    const incoming = newDocument.querySelector(".header-desktop")
    if (!incoming) return
    const current = incoming.querySelector("a[aria-current]")
    const currentHref = current?.getAttribute("href")
    const currentState = current?.getAttribute("aria-current")
    for (const link of document.querySelectorAll(".header-desktop a")) {
      if (currentState && link.getAttribute("href") === currentHref) link.setAttribute("aria-current", currentState)
      else link.removeAttribute("aria-current")
    }
  })

  document.addEventListener("click", (event) => {
    const menu = document.querySelector<HTMLDetailsElement>(openHeaderMenu)
    if (!menu || !(event.target instanceof Element)) return
    if (!menu.contains(event.target) || event.target.closest("a[href]")) closeHeaderMenu(menu, false)
  })

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !(event.target instanceof Element)) return
    const menu = event.target.closest<HTMLDetailsElement>(openHeaderMenu)
    if (!menu) return
    event.preventDefault()
    closeHeaderMenu(menu, true)
  })
</script>
