---
import type { Entry } from "../lib/content"
import type { RenderedEntry } from "../lib/entry-render"
import ArticleBody from "./ArticleBody.astro"

interface Props {
  entry: Entry
  rendered: RenderedEntry
  embedded?: boolean
}

const {
  entry,
  rendered: { Content, headings },
  embedded
} = Astro.props
---

<ArticleBody entry={entry} headings={headings} embedded={embedded}>
  <Content />
</ArticleBody>
