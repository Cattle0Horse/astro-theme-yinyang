---
import NoteListing from "../../../../../components/NoteListing.astro"
import { published, tagsFor, tagsPath } from "../../../../../lib/content"
import { site } from "../../../../../site.config"
import type { GetStaticPaths } from "astro"

export const getStaticPaths = (async ({ paginate }) =>
  tagsFor(await published("notes")).flatMap(({ id, label, entries }) => paginate(entries, { params: { tag: id }, props: { label }, pageSize: site.postsPerPage }))) satisfies GetStaticPaths

const { label, page } = Astro.props
const root = tagsPath("notes", Astro.params.tag)
if (page.currentPage === 1) return Astro.redirect(encodeURI(root), 301)
---

<NoteListing title={"#" + label} entries={page.data} root={root} current={page.currentPage} total={page.lastPage} />
