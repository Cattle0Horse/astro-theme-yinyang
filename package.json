{
  "name": "blog-theme",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "pnpm format:check && pnpm lint && astro check",
    "format": "prettier --write \"src/**/*.astro\" && oxfmt --threads 1 \"{src,tests}/**/*.{ts,tsx,css}\" \".*.json\" \"*.{ts,json,yaml}\"",
    "format:check": "prettier --check \"src/**/*.astro\" && oxfmt --check --threads 1 \"{src,tests}/**/*.{ts,tsx,css}\" \".*.json\" \"*.{ts,json,yaml}\"",
    "lint": "oxlint --threads 1 src tests astro.config.ts playwright.config.ts",
    "test": "pnpm build && node --test tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/react": "^7.1.9",
    "@astrojs/rss": "^4.0.19",
    "@prettier/parse-srcset": "^3.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "7.4.13",
    "github-slugger": "^2.0.0",
    "hast-util-from-html": "^2.1.0",
    "hast-util-to-html": "^9.0.7",
    "katex": "catalog:",
    "lucide-react": "^1.78.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "mdast-util-to-markdown": "^2.2.4",
    "micromark-util-symbol": "^2.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "mdast-util-from-markdown": "^2.1.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-util-types": "^2.0.3",
    "oxfmt": "0.79.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "5.9.3",
    "unified": "^11.0.5"
  }
}
